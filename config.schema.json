{
  "pluginAlias": "TuyaPlatform",
  "pluginType": "platform",
  "singular": true,
  "headerDisplay": "Tuya / Smart Life device integration. Cloud (REST/MQTT), Local LAN (TCP/UDP), or both simultaneously.",
  "footerDisplay": "Cloud mode: create a project at https://iot.tuya.com. Local mode: devices must be on the same LAN with local_key extracted via tuya-cli.",
  "schema": {
    "type": "object",
    "properties": {
      "name": {
        "type": "string",
        "title": "Name",
        "required": true,
        "default": "Tuya"
      },
      "options": {
        "title": "Connection Mode",
        "type": "object",
        "required": true,
        "properties": {
          "mode": {
            "title": "Mode",
            "type": "string",
            "default": "cloud",
            "oneOf": [
              { "title": "Cloud (default)", "enum": ["cloud"] },
              { "title": "Local LAN", "enum": ["local"] },
              { "title": "Both (Hybrid)", "enum": ["both"] }
            ]
          },
          "projectType": {
            "title": "Project Type (Development Method)",
            "type": "string",
            "default": "2",
            "oneOf": [
              { "title": "Custom", "enum": ["1"] },
              { "title": "Smart Home", "enum": ["2"] }
            ],
            "required": true,
            "condition": {
              "functionBody": "return model.options.mode !== 'local';"
            }
          },
          "accessId": {
            "title": "Access ID",
            "type": "string",
            "required": true,
            "condition": {
              "functionBody": "return model.options.mode !== 'local';"
            }
          },
          "accessKey": {
            "title": "Access Secret",
            "type": "string",
            "required": true,
            "condition": {
              "functionBody": "return model.options.mode !== 'local';"
            }
          },
          "countryCode": {
            "title": "Country Code",
            "type": "integer",
            "minimum": 1,
            "condition": {
              "functionBody": "return model.options.mode !== 'local' && model.options.projectType === '2';"
            }
          },
          "username": {
            "title": "Username (email)",
            "type": "string",
            "condition": {
              "functionBody": "return model.options.mode !== 'local' && model.options.projectType === '2';"
            }
          },
          "password": {
            "title": "Password",
            "type": "string",
            "format": "password",
            "condition": {
              "functionBody": "return model.options.mode !== 'local' && model.options.projectType === '2';"
            }
          },
          "appSchema": {
            "title": "App",
            "type": "string",
            "default": "tuyaSmart",
            "oneOf": [
              { "title": "Tuya Smart", "enum": ["tuyaSmart"] },
              { "title": "Smart Life", "enum": ["smartlife"] }
            ],
            "condition": {
              "functionBody": "return model.options.mode !== 'local' && model.options.projectType === '2';"
            }
          },
          "appHost": {
            "title": "App host (live view)",
            "description": "Smart Life app host used to log in and stream battery cameras over the app's MQTT broker (e.g. protect-eu.ismartlife.me). Leave empty to auto-detect from your region.",
            "type": "string",
            "format": "text",
            "condition": {
              "functionBody": "return model.options.mode !== 'local' && model.options.projectType === '2';"
            }
          },
          "local": {
            "type": "object",
            "condition": {
              "functionBody": "return model.options.mode === 'local' || model.options.mode === 'both';"
            },
            "properties": {
              "autoDiscoverDevices": {
                "title": "Auto-discover devices",
                "type": "boolean",
                "default": true
              },
              "discoverTimeout": {
                "title": "Discovery timeout (seconds)",
                "type": "integer",
                "default": 30,
                "minimum": 5
              },
              "rediscoverInterval": {
                "title": "Rediscover interval (seconds)",
                "description": "How often to re-scan the LAN for devices. 0 to disable.",
                "type": "integer",
                "default": 900,
                "minimum": 0
              },
              "devices": {
                "title": "Local Devices",
                "type": "array",
                "description": "Manually configured local devices. Auto-discovered devices can also be added here with a local_key to enable control.",
                "items": {
                  "type": "object",
                  "properties": {
                    "tuyaDeviceId": { "title": "Device ID", "type": "string", "required": true },
                    "tuyaKey": { "title": "Local Key (32 hex chars)", "type": "string" },
                    "ip": { "title": "IP Address", "type": "string" },
                    "name": { "title": "Name", "type": "string" },
                    "protocolVersion": {
                      "title": "Protocol Version",
                      "type": "string",
                      "oneOf": [
                        { "title": "3.1", "enum": ["3.1"] },
                        { "title": "3.2", "enum": ["3.2"] },
                        { "title": "3.3", "enum": ["3.3"] },
                        { "title": "3.4", "enum": ["3.4"] },
                        { "title": "3.5", "enum": ["3.5"] }
                      ]
                    },
                    "category": { "title": "Override Category", "type": "string" },
                    "switchCount": { "title": "Switch Count", "type": "integer", "minimum": 1 },
                    "outletCount": { "title": "Outlet Count", "type": "integer", "minimum": 1 },
                    "dpMapping": {
                      "title": "DP Mapping (JSON object)",
                      "description": "Custom DP code to DP ID mapping, e.g. {\"switch_1\":1}",
                      "type": "object"
                    }
                  }
                }
              }
            }
          },
          "deviceOverrides": {
            "title": "Device Override Configs",
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "title": "ID",
                  "description": "Device ID, Product ID, or `global`",
                  "type": "string",
                  "required": true
                },
                "category": {
                  "title": "Category",
                  "description": "Category code or `hidden`",
                  "type": "string"
                },
                "schema": {
                  "title": "Schema Override Configs",
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "code": {
                        "title": "DP Code",
                        "type": "string",
                        "required": true
                      },
                      "newCode": { "title": "New DP Code", "type": "string" },
                      "type": {
                        "title": "New DP Type",
                        "type": "string",
                        "default": "",
                        "oneOf": [
                          { "title": "Boolean", "enum": ["Boolean"] },
                          { "title": "Integer", "enum": ["Integer"] },
                          { "title": "Enum", "enum": ["Enum"] },
                          { "title": "String", "enum": ["String"] },
                          { "title": "Json", "enum": ["Json"] },
                          { "title": "Raw", "enum": ["Raw"] }
                        ]
                      },
                      "property": {
                        "title": "New DP Property",
                        "type": "object",
                        "properties": {
                          "min": { "title": "min", "type": "integer" },
                          "max": { "title": "max", "type": "integer" },
                          "scale": { "title": "scale", "type": "integer" },
                          "step": { "title": "step", "type": "integer" },
                          "range": {
                            "title": "range",
                            "type": "array",
                            "items": { "title": "value", "type": "string" }
                          }
                        }
                      },
                      "hidden": { "title": "Hidden", "type": "boolean" }
                    }
                  }
                }
              }
            }
          },
          "debug": {
            "title": "Enable Debug Logging",
            "type": "boolean",
            "default": true
          }
        }
      }
    }
  }
}
